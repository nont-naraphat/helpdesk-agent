# Copy to .env on NAS_02 and fill in. NEVER commit the real .env.
# docker-compose reads these automatically.

# Portal login password (admin UI). Leave blank = open mode (NOT for prod).
ADMIN_PASSWORD=change-this-strong-password

# Pre-shared key the agent uses to register. Must match $AGENT_SECRET in
# agent/install.ps1 before you package the Win32 app.
# Generate one:  openssl rand -base64 32
AGENT_SECRET=change-this-long-random-string
